@model PolicyFormViewModel
@{
    ViewData["Title"] = Model.IsEditMode ? "Editar Politica" : "Nova Politica";
    var postUrl = Model.IsEditMode ? $"/admin/policies/{Uri.EscapeDataString(Model.OriginalId ?? Model.Id)}/edit" : "/admin/policies/new";
    var selectedDays = new HashSet<string>(Model.ScheduleDays, StringComparer.OrdinalIgnoreCase);
    var dayOptions = new[]
    {
        new { Value = "MON", Label = "Segunda" },
        new { Value = "TUE", Label = "Terca" },
        new { Value = "WED", Label = "Quarta" },
        new { Value = "THU", Label = "Quinta" },
        new { Value = "FRI", Label = "Sexta" },
        new { Value = "SAT", Label = "Sabado" },
        new { Value = "SUN", Label = "Domingo" }
    };
}

<div class="page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>Configure o que sera enviado, quando, e com quais limites de recurso.</p>
    </div>
</div>

<section class="panel narrow-panel">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="error-banner">@Model.ErrorMessage</div>
    }

    <form method="post" action="@postUrl" class="form-grid">
        @Html.AntiForgeryToken()
        <div class="form-field">
            <label for="Id">ID da politica</label>
            <input id="Id" name="Id" value="@Model.Id" @(Model.IsEditMode ? "readonly" : null) />
        </div>
        <div class="form-field">
            <label for="CustomerId">CustomerId</label>
            <input id="CustomerId" name="CustomerId" value="@Model.CustomerId" required />
        </div>
        <div class="form-field">
            <label for="Name">Nome</label>
            <input id="Name" name="Name" value="@Model.Name" required />
        </div>
        <div class="form-field">
            <label for="PolicyKind">Tipo</label>
            <select id="PolicyKind" name="PolicyKind">
                <option value="operational" selected="@(Model.PolicyKind == "operational")">Operacional</option>
                <option value="bootstrap" selected="@(Model.PolicyKind == "bootstrap")">Bootstrap</option>
            </select>
        </div>
        <div class="form-field">
            <label for="ScopeType">Escopo</label>
            <select id="ScopeType" name="ScopeType">
                <option value="customer" selected="@(Model.ScopeType == "customer")">Cliente</option>
                <option value="host" selected="@(Model.ScopeType == "host")">Host</option>
            </select>
        </div>
        <div class="form-field">
            <label for="HostId">HostId</label>
            <input id="HostId" name="HostId" value="@Model.HostId" placeholder="Obrigatorio para escopo host" />
        </div>
        <div class="form-field">
            <label for="OriginHostId">Origem bootstrap</label>
            <input id="OriginHostId" name="OriginHostId" value="@Model.OriginHostId" placeholder="Preencha so se a politica veio do onboarding" />
        </div>
        <div class="form-field">
            <label for="StartTimeLocal">Horario inicial</label>
            <input id="StartTimeLocal" name="StartTimeLocal" type="time" value="@Model.StartTimeLocal" required />
        </div>
        <div class="form-field full-width">
            <label for="IncludePathsCsv">Paths de inclusao</label>
            <input id="IncludePathsCsv" name="IncludePathsCsv" value="@Model.IncludePathsCsv" placeholder="D:\Dados;C:\TRAT" required />
        </div>
        <div class="form-field full-width">
            <label for="ExcludePathsCsv">Paths de exclusao</label>
            <input id="ExcludePathsCsv" name="ExcludePathsCsv" value="@Model.ExcludePathsCsv" placeholder="D:\Dados\Temp" />
        </div>
        <div class="form-field">
            <label for="AwsRegion">Regiao AWS</label>
            <input id="AwsRegion" name="AwsRegion" value="@Model.AwsRegion" placeholder="us-east-1" />
        </div>
        <div class="form-field">
            <label for="S3BucketName">Bucket S3</label>
            <input id="S3BucketName" name="S3BucketName" value="@Model.S3BucketName" placeholder="bucket-backup-cliente" />
        </div>
        <div class="form-field full-width">
            <label for="S3KeyPrefix">Pasta/prefixo no bucket</label>
            <input id="S3KeyPrefix" name="S3KeyPrefix" value="@Model.S3KeyPrefix" placeholder="clientes/ep/trat-01" />
        </div>
        <div class="form-field full-width">
            <label>Dias da agenda</label>
            <div class="checkbox-grid">
                @foreach (var day in dayOptions)
                {
                    <label class="checkbox-chip">
                        <input type="checkbox" name="ScheduleDays" value="@day.Value" checked="@selectedDays.Contains(day.Value)" />
                        <span>@day.Label</span>
                    </label>
                }
            </div>
            <input type="hidden" name="ScheduleDaysCsv" value="@Model.ScheduleDaysCsv" />
        </div>
        <div class="form-field">
            <label for="MaxRuntimeMinutes">Janela maxima (min)</label>
            <input id="MaxRuntimeMinutes" name="MaxRuntimeMinutes" type="number" value="@Model.MaxRuntimeMinutes" required />
        </div>
        <div class="form-field">
            <label for="CpuLimitPercent">CPU max %</label>
            <input id="CpuLimitPercent" name="CpuLimitPercent" type="number" value="@Model.CpuLimitPercent" required />
        </div>
        <div class="form-field">
            <label for="NetworkLimitMbit">Rede max Mbps</label>
            <input id="NetworkLimitMbit" name="NetworkLimitMbit" type="number" value="@Model.NetworkLimitMbit" required />
        </div>
        <div class="form-field">
            <label class="toggle-row" for="Enabled">
                <span>Status</span>
                <span class="switch">
                    <input id="Enabled" name="Enabled" type="checkbox" value="true" checked="@Model.Enabled" />
                    <span class="switch-slider"></span>
                </span>
            </label>
            <input type="hidden" name="Enabled" value="false" />
        </div>
        @if (Model.IsEditMode)
        {
            <div class="form-field full-width">
                <span class="form-help">Ultima mudanca registrada: @(Model.LastChangedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</span>
            </div>
        }
        <div class="form-actions">
            <a class="button secondary" href="/admin/policies">Cancelar</a>
            <button class="button primary" type="submit">Salvar politica</button>
        </div>
    </form>
</section>

@if (Model.IsEditMode)
{
    <section class="panel narrow-panel">
        <div class="panel-header">
            <h2>Historico Recente</h2>
        </div>
        @if (Model.RecentEvents.Count == 0)
        {
            <p>Nenhum evento registrado para esta politica.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Quando</th>
                            <th>Evento</th>
                            <th>Mensagem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentEvents)
                        {
                            <tr>
                                <td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>@item.EventType</td>
                                <td>@item.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
