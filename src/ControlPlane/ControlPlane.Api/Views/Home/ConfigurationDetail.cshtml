@model AgentConfigurationDetailViewModel
@{
    ViewData["Title"] = $"Configuracao {Model.Configuration.Hostname ?? Model.Configuration.HostId}";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="page-header">
    <div>
        <h1>Configuracao do Agent</h1>
        <p>@(Model.Configuration.Hostname ?? Model.Configuration.HostId) | @(Model.Configuration.CustomerName ?? Model.Configuration.CustomerId)</p>
    </div>
    <div class="page-actions">
        <a class="button secondary" href="/admin/configurations">Voltar</a>
        <a class="button primary" href="/admin/customers/@Uri.EscapeDataString(Model.Configuration.CustomerId)">Abrir cliente</a>
    </div>
</div>

<section class="stats-grid">
    <div class="stat-card">
        <span>Servico</span>
        <strong class="small-stat">@Model.Configuration.ServiceStatus</strong>
    </div>
    <div class="stat-card">
        <span>Versao</span>
        <strong class="small-stat">@Model.Configuration.AgentVersion</strong>
    </div>
    <div class="stat-card">
        <span>Prontidao</span>
        <strong class="small-stat"><span class="badge @Model.Configuration.OperationalStatusCssClass">@Model.Configuration.OperationalStatusLabel</span></strong>
    </div>
    <div class="stat-card">
        <span>Politica</span>
        <strong class="small-stat">@(Model.Configuration.PolicyName ?? "-")</strong>
    </div>
    <div class="stat-card">
        <span>Efetiva</span>
        <strong class="small-stat">@(Model.Configuration.EffectivePolicyName ?? Model.Configuration.EffectivePolicyId ?? "-")</strong>
    </div>
    <div class="stat-card">
        <span>Upload</span>
        <strong class="small-stat">@Model.Configuration.UploadMode</strong>
    </div>
    <div class="stat-card">
        <span>Bootstrap</span>
        <strong class="small-stat"><span class="badge @Model.Configuration.BootstrapStatusCssClass">@Model.Configuration.BootstrapStatusLabel</span></strong>
    </div>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <section class="panel">
        <div class="status-banner">@statusMessage</div>
    </section>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <section class="panel">
        <div class="error-banner">@errorMessage</div>
    </section>
}

<section class="split-grid">
    <div class="panel">
        <div class="panel-header">
            <h2>Compliance</h2>
        </div>
        <div class="definition-grid">
            <div><span>TLS</span><strong>@Model.Configuration.TlsMode (@(Model.Configuration.PrecheckTlsOk ? "OK" : "Falhou"))</strong></div>
            <div><span>Disco staging</span><strong>@(Model.Configuration.PrecheckDiskOk ? "OK" : "Falhou")</strong></div>
            <div><span>Credencial</span><strong>@(Model.Configuration.PrecheckCredentialOk ? "OK" : "Falhou")</strong></div>
            <div><span>Ultima sync</span><strong>@(Model.Configuration.LastConfigSyncAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</strong></div>
            <div class="wide"><span>Ultimo precheck</span><strong>@(Model.Configuration.LastPrecheckAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-") - @(Model.Configuration.LastPrecheckMessage ?? "-")</strong></div>
            <div class="wide"><span>Staging</span><strong>@Model.Configuration.StagingPath</strong></div>
            <div class="wide"><span>Credential Target</span><strong>@Model.Configuration.CredentialTargetName</strong></div>
            <div><span>Fonte efetiva</span><strong>@(Model.Configuration.EffectivePolicySource ?? "-")</strong></div>
            <div><span>Tipo efetivo</span><strong>@(Model.Configuration.EffectivePolicyKind ?? "-")</strong></div>
            <div class="wide"><span>Ultima mudanca da politica</span><strong>@(Model.Configuration.EffectivePolicyLastChangedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</strong></div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h2>Politica aplicada</h2>
        </div>
        @if (!Model.Configuration.IsReadyForPolicyAssignment)
        {
            <div class="error-banner">Vinculo de politica bloqueado: @Model.Configuration.OperationalStatusMessage</div>
        }
        <form method="post" action="/admin/configurations/@Uri.EscapeDataString(Model.Configuration.Id)/policy" class="form-grid compact-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="form-field full-width">
                <label for="policyId">Politica elegivel</label>
                <select id="policyId" name="policyId">
                    <option value="">Sem politica vinculada</option>
                    @foreach (var option in Model.PolicyOptions)
                    {
                        <option value="@option.Id" selected="@(Model.Configuration.PolicyId == option.Id)">@option.Label</option>
                    }
                </select>
            </div>
            <div class="form-field full-width">
                <span class="form-help">Sao exibidas apenas politicas ativas do mesmo cliente e compativeis com o escopo do host.</span>
                <span class="form-help">Status atual do host: @Model.Configuration.OperationalStatusMessage</span>
            </div>
            <div class="form-actions">
                <button class="button primary" type="submit">Salvar vinculacao</button>
            </div>
        </form>
    </div>
</section>

<section class="split-grid">
    <div class="panel">
        <div class="panel-header">
            <h2>AWS no ControlPlane</h2>
        </div>
        <div class="definition-grid">
            <div><span>Status</span><strong>@(Model.AwsIntegration.IsConnected ? "Conectada" : "Nao conectada")</strong></div>
            <div><span>Conta esperada</span><strong>@(Model.AwsIntegration.ExpectedAccountId ?? "-")</strong></div>
            <div><span>Conta validada</span><strong>@(Model.AwsIntegration.ResolvedAccountId ?? "-")</strong></div>
            <div><span>Bucket atual</span><strong>@(Model.AwsIntegration.SelectedBucket ?? "-")</strong></div>
            <div><span>Regiao</span><strong>@(Model.AwsIntegration.SelectedBucketRegion ?? "-")</strong></div>
            <div class="wide"><span>Diagnostico</span><strong>@Model.AwsIntegration.Message</strong></div>
            <div class="wide"><span>Buckets</span><strong>@(Model.AwsIntegration.Buckets.Count == 0 ? "-" : string.Join(", ", Model.AwsIntegration.Buckets))</strong></div>
            <div class="wide"><span>Pastas/prefixos</span><strong>@(Model.AwsIntegration.Prefixes.Count == 0 ? "-" : string.Join(", ", Model.AwsIntegration.Prefixes))</strong></div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h2>Execucao Manual</h2>
        </div>
        @if (Model.LatestRunRequest is null)
        {
            <p>Nenhuma execucao manual solicitada para este host.</p>
        }
        else
        {
            <div class="definition-grid">
                <div><span>Status</span><strong>@Model.LatestRunRequest.State</strong></div>
                <div><span>Trigger</span><strong>@Model.LatestRunRequest.TriggerType</strong></div>
                <div><span>Solicitado em</span><strong>@Model.LatestRunRequest.RequestedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</strong></div>
                <div><span>Claimed em</span><strong>@(Model.LatestRunRequest.ClaimedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</strong></div>
                <div><span>Concluido em</span><strong>@(Model.LatestRunRequest.CompletedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</strong></div>
                <div><span>Job</span><strong>@(Model.LatestRunRequest.JobId ?? "-")</strong></div>
                <div class="wide"><span>Falha</span><strong>@(Model.LatestRunRequest.FailureMessage ?? "-")</strong></div>
            </div>
        }
        <form method="post" action="/admin/configurations/@Uri.EscapeDataString(Model.Configuration.Id)/run-now" style="margin-top:12px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button class="button primary" type="submit">Executar backup agora</button>
        </form>
    </div>
</section>

<section class="split-grid">
    <div class="panel">
        <div class="panel-header">
            <h2>Bootstrap do Host</h2>
        </div>
        <div class="definition-grid">
            <div><span>Status</span><strong><span class="badge @Model.Configuration.BootstrapStatusCssClass">@Model.Configuration.BootstrapStatusLabel</span></strong></div>
            <div class="wide"><span>Diagnostico</span><strong>@Model.Configuration.BootstrapStatusMessage</strong></div>
            <div class="wide"><span>IncludePaths reportado</span><strong>@(Model.Configuration.BootstrapIncludePathsCsv ?? "-")</strong></div>
            <div class="wide"><span>ExcludePaths reportado</span><strong>@(Model.Configuration.BootstrapExcludePathsCsv ?? "-")</strong></div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h2>Politica do Host</h2>
        </div>
        @if (!Model.BootstrapPolicyDraft.HasBootstrapPaths)
        {
            <div class="error-banner">O Agent ainda nao reportou IncludePaths bootstrap para este host.</div>
        }
        else
        {
            <form method="post" action="/admin/configurations/@Uri.EscapeDataString(Model.Configuration.Id)/bootstrap-policy" class="form-grid compact-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <input type="hidden" name="SuggestedPolicyId" value="@Model.BootstrapPolicyDraft.SuggestedPolicyId" />
                <input type="hidden" name="CustomerId" value="@Model.BootstrapPolicyDraft.CustomerId" />
                <input type="hidden" name="HostId" value="@Model.BootstrapPolicyDraft.HostId" />
                <input type="hidden" name="ScopeType" value="@Model.BootstrapPolicyDraft.ScopeType" />
                <input type="hidden" name="Enabled" value="@Model.BootstrapPolicyDraft.Enabled" />

                <div class="form-field full-width">
                    <label for="Name">Nome da politica</label>
                    <input id="Name" name="Name" value="@Model.BootstrapPolicyDraft.Name" />
                </div>
                <div class="form-field full-width">
                    <label for="IncludePathsCsv">IncludePaths</label>
                    <textarea id="IncludePathsCsv" name="IncludePathsCsv" rows="4">@Model.BootstrapPolicyDraft.IncludePathsCsv</textarea>
                </div>
                <div class="form-field full-width">
                    <label for="ExcludePathsCsv">ExcludePaths</label>
                    <textarea id="ExcludePathsCsv" name="ExcludePathsCsv" rows="3">@Model.BootstrapPolicyDraft.ExcludePathsCsv</textarea>
                </div>
                <div class="form-field">
                    <label for="AwsRegion">Regiao AWS</label>
                    <input id="AwsRegion" name="AwsRegion" value="@Model.BootstrapPolicyDraft.AwsRegion" placeholder="us-east-1" />
                </div>
                <div class="form-field">
                    <label for="S3BucketName">Bucket S3</label>
                    <input id="S3BucketName" name="S3BucketName" list="bucket-options" value="@Model.BootstrapPolicyDraft.S3BucketName" placeholder="bucket-backup" />
                    <datalist id="bucket-options">
                        @foreach (var bucket in Model.AwsIntegration.Buckets)
                        {
                            <option value="@bucket"></option>
                        }
                    </datalist>
                </div>
                <div class="form-field full-width">
                    <label for="S3KeyPrefix">Pasta/prefixo no bucket</label>
                    <input id="S3KeyPrefix" name="S3KeyPrefix" list="prefix-options" value="@Model.BootstrapPolicyDraft.S3KeyPrefix" placeholder="clientes/ep/webstation-01" />
                    <datalist id="prefix-options">
                        @foreach (var prefix in Model.AwsIntegration.Prefixes)
                        {
                            <option value="@prefix"></option>
                        }
                    </datalist>
                </div>
                <div class="form-field">
                    <label for="ScheduleDaysCsv">Dias</label>
                    <input id="ScheduleDaysCsv" name="ScheduleDaysCsv" value="@Model.BootstrapPolicyDraft.ScheduleDaysCsv" />
                </div>
                <div class="form-field">
                    <label for="StartTimeLocal">Horario</label>
                    <input id="StartTimeLocal" name="StartTimeLocal" value="@Model.BootstrapPolicyDraft.StartTimeLocal" />
                </div>
                <div class="form-field">
                    <label for="MaxRuntimeMinutes">Max runtime (min)</label>
                    <input id="MaxRuntimeMinutes" name="MaxRuntimeMinutes" type="number" min="1" value="@Model.BootstrapPolicyDraft.MaxRuntimeMinutes" />
                </div>
                <div class="form-field">
                    <label for="CpuLimitPercent">CPU max (%)</label>
                    <input id="CpuLimitPercent" name="CpuLimitPercent" type="number" min="1" max="100" value="@Model.BootstrapPolicyDraft.CpuLimitPercent" />
                </div>
                <div class="form-field">
                    <label for="NetworkLimitMbit">Rede max (Mbit)</label>
                    <input id="NetworkLimitMbit" name="NetworkLimitMbit" type="number" min="1" value="@Model.BootstrapPolicyDraft.NetworkLimitMbit" />
                </div>
                <div class="form-field full-width">
                    <span class="form-help">O caminho nasce no host, mas bucket, pasta, agenda e limites ficam centralizados no ControlPlane.</span>
                    <span class="form-help">Se o host estiver pronto, o painel vincula automaticamente essa politica a configuracao.</span>
                    @if (Model.Configuration.IsBootstrapPolicyAssigned)
                    {
                        <span class="form-help">A politica atual ja esta vinculada ao host; este formulario funciona como atualizacao centralizada.</span>
                    }
                    else if (Model.Configuration.BootstrapPolicyExists)
                    {
                        <span class="form-help">A politica do host ja existe no painel e esta aguardando vinculacao ou revisao.</span>
                    }
                </div>
                <div class="form-actions">
                    <button class="button primary" type="submit">@BootstrapSubmitLabel(Model.Configuration)</button>
                </div>
            </form>
        }
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <h2>Jobs recentes do host</h2>
    </div>
        <div class="table-wrap">
        <table class="table responsive-table rt-config-jobs">
            <thead>
                <tr>
                    <th>Job</th>
                    <th>Status</th>
                    <th>Inicio</th>
                    <th>Enviado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentJobs.Count == 0)
                {
                    <tr>
                        <td colspan="4">Nenhum job encontrado.</td>
                    </tr>
                }
                else
                {
                    @foreach (var job in Model.RecentJobs)
                    {
                        <tr>
                            <td><a href="/admin/jobs/@Uri.EscapeDataString(job.Id)">@job.Id</a></td>
                            <td><span class="badge @job.State.ToLowerInvariant()">@job.State</span></td>
                            <td>@job.StartedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@($"{job.UploadedItems:N0} / {FormatBytes(job.UploadedBytes)}")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
</section>

@functions {
    private static string BootstrapSubmitLabel(AgentConfigurationListItemViewModel configuration)
    {
        if (configuration.IsBootstrapPolicyAssigned)
        {
            return "Atualizar politica do host";
        }

        if (configuration.BootstrapPolicyExists)
        {
            return "Atualizar politica e tentar vincular";
        }

        return "Salvar politica do host";
    }

    private static string FormatBytes(long value)
    {
        string[] suffixes = ["B", "KB", "MB", "GB", "TB"];
        double size = value;
        var index = 0;
        while (size >= 1024 && index < suffixes.Length - 1)
        {
            size /= 1024;
            index++;
        }

        return $"{size:N1} {suffixes[index]}";
    }
}
