@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - TRAT</title>
    <link rel="icon" type="image/png" href="~/img/trat-logo.png" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/js/app.js" defer></script>
</head>
<body class="login-body app-body">
    <div class="login-shell">
        <div class="login-card">
            <div class="brand">
                <img class="brand-logo" src="~/img/trat-logo.png" alt="TRAT" />
                <div class="brand-title">TRAT</div>
                <div class="brand-subtitle">Acesso ao painel</div>
            </div>
            <h1>Entrar</h1>
            <p>Use seu e-mail e senha para acessar o painel.</p>
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error-banner">@Model.ErrorMessage</div>
        }
            <form method="post" action="/login" class="login-form">
                @Html.AntiForgeryToken()
                <div class="form-field full-width">
                    <label for="email">E-mail</label>
                    <input id="email" name="email" type="email" value="@Model.Email" autocomplete="username" required />
                </div>
                <div class="form-field full-width">
                    <label for="password">Senha</label>
                    <input id="password" name="password" type="password" autocomplete="current-password" required />
                </div>
                <button class="button primary full" type="submit">Entrar</button>
            </form>
        </div>
    </div>
</body>
</html>
