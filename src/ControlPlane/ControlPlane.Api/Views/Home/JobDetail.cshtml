@model JobDetailViewModel
@{
    ViewData["Title"] = $"Job {Model.Job.Id}";
}

<div class="page-header">
    <div>
        <h1>Job @Model.Job.Id</h1>
        <p>@(Model.Job.CustomerName ?? Model.Job.CustomerId) | @(Model.Job.Hostname ?? Model.Job.HostId)</p>
    </div>
    <div class="page-actions">
        <a class="button secondary" href="/admin/jobs">Voltar</a>
        <a class="button primary" href="/admin/customers/@Uri.EscapeDataString(Model.Job.CustomerId)">Abrir cliente</a>
    </div>
</div>

<section class="stats-grid">
    <div class="stat-card">
        <span>Status</span>
        <strong class="small-stat"><span class="badge @Model.Job.State.ToLowerInvariant()">@Model.Job.State</span></strong>
    </div>
    <div class="stat-card">
        <span>Planejado</span>
        <strong class="small-stat">@($"{Model.Job.PlannedItems:N0} / {FormatBytes(Model.Job.PlannedBytes)}")</strong>
    </div>
    <div class="stat-card">
        <span>Enviado</span>
        <strong class="small-stat">@($"{Model.Job.UploadedItems:N0} / {FormatBytes(Model.Job.UploadedBytes)}")</strong>
    </div>
    <div class="stat-card">
        <span>Falha</span>
        <strong class="small-stat">@(string.IsNullOrWhiteSpace(Model.Job.FailureCode) ? "-" : Model.Job.FailureCode)</strong>
    </div>
</section>

<section class="split-grid">
    <div class="panel">
        <div class="panel-header">
            <h2>Resumo do job</h2>
        </div>
        <div class="definition-grid">
            <div><span>Cliente</span><strong>@(Model.Job.CustomerName ?? Model.Job.CustomerId)</strong></div>
            <div><span>Host</span><strong>@(Model.Job.Hostname ?? Model.Job.HostId)</strong></div>
            <div><span>Inicio</span><strong>@Model.Job.StartedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</strong></div>
            <div><span>Fim</span><strong>@(Model.Job.FinishedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</strong></div>
            <div class="wide"><span>Mensagem de falha</span><strong>@(Model.Job.FailureMessage ?? "-")</strong></div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h2>Artefatos</h2>
        </div>
        <div class="table-wrap">
        <table class="table responsive-table rt-job-artifacts">
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Localizacao</th>
                    <th>Criado em</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Artifacts.Count == 0)
                {
                    <tr>
                        <td colspan="3">Nenhum artefato registrado.</td>
                    </tr>
                }
                else
                {
                    @foreach (var artifact in Model.Artifacts)
                    {
                        <tr>
                            <td>@artifact.Type</td>
                            <td class="mono-cell">@artifact.Location</td>
                            <td>@artifact.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <h2>Alertas relacionados</h2>
    </div>
    <div class="table-wrap">
    <table class="table responsive-table rt-job-alerts">
        <thead>
            <tr>
                <th>Severidade</th>
                <th>Tipo</th>
                <th>Mensagem</th>
                <th>Data</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Alerts.Count == 0)
            {
                <tr>
                    <td colspan="4">Nenhum alerta relacionado.</td>
                </tr>
            }
            else
            {
                @foreach (var alert in Model.Alerts)
                {
                    <tr>
                        <td><span class="badge @alert.Severity.ToLowerInvariant()">@alert.Severity</span></td>
                        <td>@alert.Type</td>
                        <td>@alert.Message</td>
                        <td>@alert.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
</section>

@functions {
    private static string FormatBytes(long value)
    {
        string[] suffixes = ["B", "KB", "MB", "GB", "TB"];
        double size = value;
        var index = 0;
        while (size >= 1024 && index < suffixes.Length - 1)
        {
            size /= 1024;
            index++;
        }

        return $"{size:N1} {suffixes[index]}";
    }
}
