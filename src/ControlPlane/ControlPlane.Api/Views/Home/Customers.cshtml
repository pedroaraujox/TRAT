@model CustomersPageViewModel
@{
    ViewData["Title"] = "Clientes";
}

<div class="page-header">
    <div>
        <h1>Clientes</h1>
        <p>Cadastre o cliente, copie o token e use no Agent.</p>
    </div>
    <a class="button primary" href="/admin/customers/new">Novo cliente</a>
</div>

<section class="panel">
    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="status-banner">@statusMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="error-banner">@errorMessage</div>
    }

    <form method="get" action="/admin/customers" class="filters">
        <input type="text" name="q" value="@Model.Search" placeholder="Buscar por ID, nome ou conta AWS" />
        <button type="submit" class="button primary">Filtrar</button>
    </form>
    <div class="table-wrap">
        <table class="table responsive-table rt-customers">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Conta AWS</th>
                    <th>Hosts</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Customers.Count == 0)
                {
                    <tr>
                        <td colspan="5">Nenhum cliente encontrado.</td>
                    </tr>
                }
                else
                {
                    @foreach (var customer in Model.Customers)
                    {
                        <tr>
                            <td>@customer.Id</td>
                            <td><a href="/admin/customers/@Uri.EscapeDataString(customer.Id)">@customer.Name</a></td>
                            <td>@customer.AwsAccountId</td>
                            <td>@customer.HostCount</td>
                            <td class="actions-cell">
                                <a href="/admin/customers/@Uri.EscapeDataString(customer.Id)">Abrir</a>
                                <a href="/admin/customers/@Uri.EscapeDataString(customer.Id)/edit">Editar</a>
                                <form method="post" action="/admin/customers/@Uri.EscapeDataString(customer.Id)/delete" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja excluir este cliente e todos os dados relacionados?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="/admin/customers" />
                                    <button type="submit" class="button danger">Excluir</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
