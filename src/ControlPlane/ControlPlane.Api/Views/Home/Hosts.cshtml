@model HostsPageViewModel
@{
    ViewData["Title"] = "Hosts";
}

<div class="page-header">
    <div>
        <h1>Hosts</h1>
        <p>Status operacional de heartbeat e sistema operacional.</p>
    </div>
    <div class="page-actions">
        <a class="button primary" href="/admin/hosts/new">Novo host</a>
    </div>
</div>

<section class="panel">
    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="status-banner">@statusMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="error-banner">@errorMessage</div>
    }

    <form method="get" action="/admin/hosts" class="filters">
        <input type="text" name="customerId" value="@Model.CustomerId" placeholder="Filtrar por cliente" />
        <select name="status">
            <option value="">Todos os status</option>
            <option value="Online" selected="@(Model.Status == "Online")">Online</option>
            <option value="Atrasado" selected="@(Model.Status == "Atrasado")">Atrasado</option>
            <option value="Offline" selected="@(Model.Status == "Offline")">Offline</option>
            <option value="Sem heartbeat" selected="@(Model.Status == "Sem heartbeat")">Sem heartbeat</option>
        </select>
        <button type="submit" class="button primary">Filtrar</button>
    </form>
    <div class="table-wrap">
        <table class="table responsive-table rt-hosts">
            <thead>
                <tr>
                    <th>Host</th>
                    <th>Cliente</th>
                    <th>SO</th>
                    <th>Ultimo Heartbeat</th>
                    <th>Status</th>
                    <th>Servico</th>
                    <th>Politica</th>
                    <th>Prechecks</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Hosts.Count == 0)
                {
                    <tr>
                        <td colspan="9">Nenhum host encontrado.</td>
                    </tr>
                }
                else
                {
                    @foreach (var host in Model.Hosts)
                    {
                        <tr>
                            <td>@host.Hostname</td>
                            <td><a href="/admin/customers/@Uri.EscapeDataString(host.CustomerId)">@(host.CustomerName ?? host.CustomerId)</a></td>
                            <td>@host.OsVersion</td>
                            <td>@(host.LastHeartbeatAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</td>
                            <td><span class="badge @host.HeartbeatStatus.ToLowerInvariant().Replace(" ", "-")">@host.HeartbeatStatus</span></td>
                            <td>@(host.ServiceStatus ?? "-")</td>
                            <td>@(host.AssignedPolicyName ?? "-")</td>
                            <td>@($"{BoolText(host.PrecheckTlsOk)} / {BoolText(host.PrecheckDiskOk)} / {BoolText(host.PrecheckCredentialOk)}")</td>
                            <td class="actions-cell">
                                <a href="/admin/hosts/@Uri.EscapeDataString(host.Id)/edit">Editar</a>
                                @if (!string.IsNullOrWhiteSpace(host.ConfigurationId))
                                {
                                    <a href="/admin/configurations/@Uri.EscapeDataString(host.ConfigurationId)">Configuracao</a>
                                }
                                else
                                {
                                    <span class="muted-text">Sem config</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@functions {
    private static string BoolText(bool? value) => value.HasValue ? (value.Value ? "OK" : "Falhou") : "-";
}
