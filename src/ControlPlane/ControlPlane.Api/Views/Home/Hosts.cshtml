@model HostsPageViewModel
@{
    ViewData["Title"] = "Hosts";
}

<div class="page-header">
    <div>
        <h1>Hosts</h1>
        <p>Confirme aqui se o Agent instalou, apareceu e manteve heartbeat.</p>
    </div>
</div>

<section class="panel">
    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="status-banner">@statusMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="error-banner">@errorMessage</div>
    }

    <form method="get" action="/admin/hosts" class="filters">
        <input type="text" name="customerId" value="@Model.CustomerId" placeholder="Filtrar por cliente" />
        <select name="status">
            <option value="">Todos os status</option>
            <option value="Pronto" selected="@(Model.Status == "Pronto")">Pronto</option>
            <option value="Pendente AWS" selected="@(Model.Status == "Pendente AWS")">Pendente AWS</option>
            <option value="Atencao" selected="@(Model.Status == "Atencao")">Atencao</option>
            <option value="Nao validado" selected="@(Model.Status == "Nao validado")">Nao validado</option>
            <option value="Online" selected="@(Model.Status == "Online")">Online</option>
            <option value="Atrasado" selected="@(Model.Status == "Atrasado")">Atrasado</option>
            <option value="Offline" selected="@(Model.Status == "Offline")">Offline</option>
            <option value="Sem heartbeat" selected="@(Model.Status == "Sem heartbeat")">Sem heartbeat</option>
        </select>
        <select name="recoveryStatus">
            <option value="">Toda a saude</option>
            <option value="Critico" selected="@(Model.RecoveryStatus == "Critico")">Critico</option>
            <option value="Atencao" selected="@(Model.RecoveryStatus == "Atencao")">Atencao</option>
            <option value="Estavel" selected="@(Model.RecoveryStatus == "Estavel")">Estavel</option>
        </select>
        <button type="submit" class="button primary">Filtrar</button>
    </form>
    <div class="table-wrap">
        <table class="table responsive-table rt-hosts">
            <thead>
                <tr>
                    <th>Host</th>
                    <th>Cliente</th>
                    <th>Ultimo Heartbeat</th>
                    <th>Status</th>
                    <th>Ultimo backup</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Hosts.Count == 0)
                {
                    <tr>
                        <td colspan="6">Nenhum host encontrado.</td>
                    </tr>
                }
                else
                {
                    @foreach (var host in Model.Hosts)
                    {
                        <tr>
                            <td>@host.Hostname</td>
                            <td><a href="/admin/customers/@Uri.EscapeDataString(host.CustomerId)">@(host.CustomerName ?? host.CustomerId)</a></td>
                            <td>@(host.LastHeartbeatAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</td>
                            <td>
                                <div class="status-stack">
                                    <span class="badge @host.OperationalStatusCssClass">@host.OperationalStatusLabel</span>
                                    <div class="status-detail">@host.HeartbeatStatus</div>
                                </div>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(host.LastJobState))
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <div class="status-stack">
                                        <span class="badge @host.LastJobState.ToLowerInvariant()">@host.LastJobState</span>
                                        <div class="status-detail">@(host.LastJobAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                                    </div>
                                }
                            </td>
                            <td class="actions-cell">
                                <a href="/admin/hosts/@Uri.EscapeDataString(host.Id)/edit">Gerenciar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
