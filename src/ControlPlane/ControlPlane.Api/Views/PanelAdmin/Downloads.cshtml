@model AgentDownloadViewModel
@{
    ViewData["Title"] = "Downloads";
}

<div class="page-header">
    <div>
        <h1>Downloads</h1>
        <p>Distribuicao centralizada do TRAT Agent na versao mais recente publicada.</p>
    </div>
    <div class="page-actions">
        <a class="button secondary" href="/admin/customers">Clientes</a>
    </div>
</div>

<section class="split-grid">
    <div class="panel">
        <div class="panel-header">
            <h2>Pacote atual do TRAT Agent</h2>
        </div>
        <div class="definition-grid">
            <div><span>Status</span><strong>@(Model.IsAvailable ? "Disponivel" : "Indisponivel")</strong></div>
            <div><span>Versao</span><strong>@(Model.Version ?? "-")</strong></div>
            <div><span>Publicado em</span><strong>@(Model.PublishedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</strong></div>
            <div class="wide"><span>Origem</span><strong>@Model.SearchRoot</strong></div>
            <div class="wide"><span>Mensagem</span><strong>@Model.Message</strong></div>
        </div>
        <div class="form-actions">
            <a class="button primary @(Model.HasSetupExe ? string.Empty : "disabled")" href="@(Model.HasSetupExe ? "/admin/downloads/agent/setup" : "#")">Baixar TRAT Agent (TRAT.Agent.Setup.exe)</a>
        </div>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h2>Uso recomendado</h2>
        </div>
        <ul class="list">
            <li>Baixe e execute o `TRAT.Agent.Setup.exe`. Ele ja contem tudo que precisa, nao exige extrair pasta nenhuma.</li>
            <li>Ao publicar uma nova versao do TRAT Agent, publique novamente o pacote para que esta pagina entregue a versao atualizada.</li>
        </ul>
    </div>
</section>
