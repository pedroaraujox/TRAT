{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "trat.outboxtech.com.br",
  "ControlPlane": {
    "Security": {
      "AgentToken": "SET_VIA_ENV_VAR",
      "AdminToken": "SET_VIA_ENV_VAR"
    },
    "BootstrapAdmin": {
      "Email": "SET_VIA_ENV_VAR",
      "DisplayName": "Administrador",
      "Password": "SET_VIA_ENV_VAR"
    },
    "AgentDownloads": {
      "ArtifactsRoot": "/app/artifacts"
    },
    "Database": {
      "UsePostgres": true,
      "SqlitePath": null
    },
    "Seed": {
      "EnableDemoData": false
    },
    "Smtp": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "From": "backup@outboxtech.com.br"
    }
  }
}
